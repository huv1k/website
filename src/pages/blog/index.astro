---
import ContentIndexPage from '../../components/pages/content-index-page.astro';
import { getLocalizedEntries } from '../../lib/content';

const posts = (await getLocalizedEntries('blog', 'en')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<ContentIndexPage locale="en" section="blog" entries={posts} />
