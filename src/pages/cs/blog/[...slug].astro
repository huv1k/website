---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticlePage from '../../../components/pages/article-page.astro';
import {
  getEntrySlug,
  getLocalizedEntries,
  hasTranslation,
} from '../../../lib/content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const posts = await getLocalizedEntries('blog', 'cs');

  return posts.map((post) => ({
    params: { slug: getEntrySlug(post) },
    props: {
      post,
      hasAlternate: hasTranslation(allPosts, getEntrySlug(post), 'en'),
    },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  hasAlternate: boolean;
}

const { post, hasAlternate } = Astro.props;
const { Content } = await render(post);
---

<ArticlePage
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  locale="cs"
  hasAlternate={hasAlternate}
>
  <Content />
</ArticlePage>
