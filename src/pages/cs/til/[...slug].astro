---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticlePage from '../../../components/pages/article-page.astro';
import {
  getEntrySlug,
  getLocalizedEntries,
  hasTranslation,
} from '../../../lib/content';

export async function getStaticPaths() {
  const allEntries = await getCollection('til');
  const entries = await getLocalizedEntries('til', 'cs');

  return entries.map((entry) => ({
    params: { slug: getEntrySlug(entry) },
    props: {
      entry,
      hasAlternate: hasTranslation(allEntries, getEntrySlug(entry), 'en'),
    },
  }));
}

interface Props {
  entry: CollectionEntry<'til'>;
  hasAlternate: boolean;
}

const { entry, hasAlternate } = Astro.props;
const { Content } = await render(entry);
---

<ArticlePage
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.date}
  locale="cs"
  hasAlternate={hasAlternate}
>
  <Content />
</ArticlePage>
