---
import ContentIndexPage from '../../../components/pages/content-index-page.astro';
import { getLocalizedEntries } from '../../../lib/content';

const entries = (await getLocalizedEntries('til', 'cs')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<ContentIndexPage locale="cs" section="til" entries={entries} />
