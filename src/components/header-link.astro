---
/**
 * Navigation link that automatically bolds itself when active.
 *
 * Active-state detection works by stripping the base URL prefix from the
 * current pathname, then checking two conditions:
 * 1. Exact match: `href` equals the stripped pathname.
 * 2. Section match: `href` equals `/<first-segment>`, so `/blog/my-post`
 *    still highlights the `/blog` nav link.
 */
import type { HTMLAttributes } from 'astro/types';

export type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props as Props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname =
  (baseUrl && Astro.url.pathname.startsWith(baseUrl)
    ? Astro.url.pathname.slice(baseUrl.length) || '/'
    : Astro.url.pathname
  )
    .replace(/\/index\.html$/, '/')
    .replace(/\.html$/, '')
    .replace(/\/+$/, '') || '/';
const isHome = href === '/' || href === '/cs';
const isActive = href === pathname || (!isHome && pathname.startsWith(`${href}/`));
---

<a href={href} class:list={[className, { 'font-bold': isActive }]} {...props}>
  <slot />
</a>
