---
interface Props {
  date: Date;
  locale?: 'en' | 'cs';
}

const { date, locale = 'en' } = Astro.props;
---

<time datetime={date.toISOString()}>
  {
    date.toLocaleDateString(locale === 'cs' ? 'cs-CZ' : 'en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  }
</time>
