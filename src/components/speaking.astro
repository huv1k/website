---
import { siteCopy, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = siteCopy[locale].speaking;
---

<section class="mb-8">
  <h2 class="text-lg font-bold uppercase">{copy.title}</h2>
  {
    copy.talks.map((talk) => (
      <div class="flex flex-col gap-1 sm:flex-row sm:justify-between sm:gap-0">
        <a
          href={talk.href}
          target="_blank"
          rel="noopener noreferrer"
          data-seline-event="speaking_click"
          data-seline-talk={talk.name}
        >
          {talk.name}
        </a>
        <p class="text-stone-400 dark:text-stone-500">{talk.location}</p>
      </div>
    ))
  }
</section>
