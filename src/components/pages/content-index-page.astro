---
import Layout from '../../layouts/layout.astro';
import FormattedDate from '../FormattedDate.astro';
import { getLocalePath, siteCopy, type Locale } from '../../i18n';
import { getEntrySlug } from '../../lib/content';

interface Entry {
  id: string;
  data: {
    title: string;
    description: string;
    date: Date;
  };
}

interface Props {
  locale: Locale;
  section: 'blog' | 'til';
  entries: Entry[];
}

const { locale, section, entries } = Astro.props;
const copy = siteCopy[locale][section];
---

<Layout title={copy.pageTitle} description={copy.description.replace(/<[^>]+>/g, '')} locale={locale}>
  <h1 class="text-2xl font-bold uppercase mb-4">{copy.title}</h1>
  <p class="mb-8" set:html={copy.description} />
  {
    entries.map((entry) => (
      <article class="w-full">
        <div class="flex flex-col gap-1 sm:flex-row sm:justify-between sm:items-center sm:gap-0">
          <h2 class="text-xl font-bold mb-2">
            <a href={getLocalePath(locale, `/${section}/${getEntrySlug(entry)}`)}>{entry.data.title}</a>
          </h2>
          <p class="text-gray-500 dark:text-gray-400 text-sm">
            <FormattedDate date={entry.data.date} locale={locale} />
          </p>
        </div>
        <p class="text-gray-700 dark:text-gray-300 mb-4">{entry.data.description}</p>
      </article>
    ))
  }
</Layout>
