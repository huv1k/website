---
import { Image } from 'astro:assets';
import Layout from '../../layouts/layout.astro';
import type { Locale } from '../../i18n';

interface Props {
  title: string;
  description: string;
  date: Date;
  locale: Locale;
  hasAlternate: boolean;
}

const { title, description, date, locale, hasAlternate } = Astro.props;
---

<Layout
  title={`Huvik - ${title}`}
  description={description}
  locale={locale}
  hasAlternate={hasAlternate}
>
  <article class="mb-16">
    <h1 class="text-2xl font-bold uppercase mb-4">{title}</h1>
    <div class="flex flex-col gap-3 mb-8 text-sm text-gray-600 dark:text-gray-400 sm:flex-row sm:items-center sm:justify-between sm:gap-0">
      <div class="flex items-center gap-3">
        <Image
          src="/lukas-huvar.jpg"
          alt="Lukáš Huvar"
          class="w-8 h-8 rounded-full grayscale"
          width={32}
          height={32}
          inferSize
          loading="eager"
        />
        <span class="font-bold text-gray-900 dark:text-gray-100">Lukáš Huvar</span>
      </div>
      <time datetime={date.toISOString()}>
        {
          date.toLocaleDateString(locale === 'cs' ? 'cs-CZ' : 'en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })
        }
      </time>
    </div>
    <div class="markdown">
      <slot />
    </div>
  </article>
</Layout>
