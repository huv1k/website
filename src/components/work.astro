---
import WorkExperience from './work-experience.astro';
import { siteCopy, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = siteCopy[locale].work;
---

<section class="mb-12">
  <h2 class="text-lg font-bold uppercase mb-4">{copy.title}</h2>
  <div class="space-y-4">
    {
      copy.entries.map((entry) => (
        <WorkExperience
          company={entry.company}
          logo={entry.logo}
          from={entry.from}
          to={entry.to}
          role={entry.role}
          locale={locale}
          presentLabel={copy.present}
        >
          {entry.paragraphs.map((paragraph, index) => (
            <p class:list={{ 'pb-4': index < entry.paragraphs.length - 1 }} set:html={paragraph} />
          ))}
        </WorkExperience>
      ))
    }
  </div>
</section>
